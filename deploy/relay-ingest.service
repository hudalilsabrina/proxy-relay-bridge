[Unit]
Description=Relay Ingest API (terima proxy dari agent luar)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mrscraper-relay/ingest.py
# 8787 untuk umum, 8080 untuk klien yang firewall-nya hanya membuka port web standar
Environment=INGEST_PORTS=8787,8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
